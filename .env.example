# Copy using python -m app.setup; keep this file and the resulting .env on the VPS only.
BASE_URL=http://localhost:8000
DATA_DIR=./data
# Supabase > Connect > Session pooler, port 5432. URL-encode password characters.
# Replace with postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/local.db
ENCRYPTION_KEY=
ADMIN_PASSWORD_HASH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Select an API version supported by your Meta app.
META_API_VERSION=v23.0

MAX_UPLOAD_MB=250
MAX_STORAGE_MB=5000
MEDIA_RETENTION_DAYS=7
WORKER_ENABLED=true
# Host loopback port; 8000 is already used by another app on the shared VPS.
PUBLISHER_PORT=8090

# Used by the optional Caddy HTTPS reverse proxy.
APP_DOMAIN=publisher.example.com
ACME_EMAIL=admin@example.com
# Telegram/n8n automation (disabled until configured); store secret as n8n credential.
TIKTOK_INGEST_ENABLED=false
AUTOMATION_TOKEN=
AUTOMATION_YOUTUBE_ACCOUNT_ID=
